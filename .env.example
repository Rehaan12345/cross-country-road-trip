# Copy to .env.local for local dev; set the same values in Vercel for production.
# All server-side only — none of these are exposed to the browser.

SUPABASE_URL=https://bbdrhjpipechbyvhwhwa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The passphrase that gates Start/Stop. Any long phrase you'll remember.
APP_PASSPHRASE=

# Optional. A second passphrase that sees everything and changes nothing — hand
# it to anyone following the drive. Leave blank to switch view-only sharing off;
# an empty value never authenticates. Must differ from APP_PASSPHRASE.
APP_VIEW_PASSPHRASE=
